---
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import Sidebar from '../components/Sidebar.astro';
import MobileHeader from '../components/MobileHeader.astro';
import Footer from '../components/Footer.astro';
import { site, type PageKey, type NavSection } from '../data/site';
import '../styles/global.css';

// Self-hosted fonts, Latin character set only (no requests to Google).
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  lang: 'en' | 'de';
  slug: string;
  current: PageKey;
  sections?: NavSection[];
}
const { title, description, lang, slug, current, sections = [] } = Astro.props;

const pathFor = (l: string, s: string) => (l === 'en' ? '/' : `/${l}/`) + (s ? `${s}/` : '');
const canonical = new URL(pathFor(lang, slug), Astro.site);

// hreflang links: only for language versions that actually exist.
const all = await getCollection('pages');
const versions = all.filter((p) => p.data.slug === slug).map((p) => p.data.lang);
const alternates = versions.length > 1
  ? versions.map((l) => ({ lang: l, href: new URL(pathFor(l, slug), Astro.site).href }))
  : [];

const fontCss = `
@font-face{font-family:'Fraunces';font-style:normal;font-display:swap;font-weight:100 900;src:url(${frauncesUrl}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Inter';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interUrl}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(pathFor('en', slug), Astro.site).href} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F4EFE6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    <meta name="twitter:card" content="summary" />

    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss}></style>
    <script is:inline>
      document.documentElement.classList.add('js');
      document.addEventListener('astro:after-swap', function () { document.documentElement.classList.add('js'); });
    </script>
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="glow" aria-hidden="true" data-glow></div>
    <canvas class="field" aria-hidden="true" data-field transition:persist="field"></canvas>
    <MobileHeader current={current} sections={sections} />
    <Sidebar current={current} sections={sections} />
    <main id="main" class="content" transition:animate="fade">
      <div class="content-inner">
        <slot />
        <Footer />
      </div>
    </main>
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
