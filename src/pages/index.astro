---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ContactCta from '../components/ContactCta.astro';
import Motif from '../components/Motif.astro';
import { site } from '../data/site';
import { home } from '../data/en/home';

const page = await getEntry('pages', 'en/home');
if (!page) throw new Error('Missing src/content/pages/en/home.md');
const { title, description, lang, slug } = page.data;
---
<BaseLayout title={title} description={description} lang={lang} slug={slug} current="home" sections={home.sections}>
  <section class="hero" aria-label="Intro">
    <div class="hero-mobile">
      <h1 class="hero-name">Amr<br />Ibrahim</h1>
      <p class="hero-role">{site.role}<br /><span class="muted">{site.location}</span></p>
      <p class="hero-headline">{site.headline}</p>
    </div>
    <div class="hero-motif"><Motif /></div>
    <div class="hero-row">
      <dl class="facts">
        {home.facts.map((f) => (
          <div><dt class="small muted">{f.term}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
      <figure class="portrait">
        <div class="portrait-img" role="img" aria-label="Portrait placeholder">[Portrait: headshot to come]</div>
        <figcaption class="small muted">{home.portraitCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section id="in-short" class="sec reveal">
    <SectionTitle num={1}>In short</SectionTitle>
    <p class="lede">{home.pitch}</p>
    <p class="supporting muted">{home.supporting}</p>
    <div class="keyfacts">
      {home.keyFacts.map((k) => (
        <div>
          <p class="keyfact-num" data-count={k.value}>{k.value}</p>
          <p class="keyfact-label muted">{k.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="what-i-do" class="sec reveal">
    <SectionTitle num={2}>What I do</SectionTitle>
    <div class="two-col">
      <div>
        <div class="rule-thin" aria-hidden="true"></div>
        <p class="label col-label">{home.delivery.label}</p>
        {home.delivery.items.map((i) => (<><h3 class="item-title">{i.title}</h3><p>{i.text}</p></>))}
      </div>
      <div>
        <div class="rule-accent" aria-hidden="true"></div>
        <p class="label label--accent col-label">{home.governance.label}</p>
        {home.governance.items.map((i) => (<><h3 class="item-title">{i.title}</h3><p>{i.text}</p></>))}
      </div>
    </div>
  </section>

  <section id="read-more" class="sec reveal">
    <SectionTitle num={3}>Read more</SectionTitle>
    <ul class="go-list">
      {home.readMore.map((r) => (
        <li>
          <a href={r.href} class="go">
            <span><span class="go-title">{r.title}</span><span class="go-text muted">{r.text}</span></span>
            <span class="go-line" aria-hidden="true"><span class="go-ln"></span><span class="go-dot"></span></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <ContactCta num={4} />
</BaseLayout>

<style>
  .hero-mobile { margin-bottom: 40px; }
  .hero-name {
    margin: 0;
    font-family: var(--serif); font-weight: 340;
    font-size: clamp(3.5rem, 16vw, 4.5rem); line-height: 0.88; letter-spacing: -0.045em;
    font-variation-settings: 'opsz' 144;
  }
  .hero-role { margin-top: 24px; font-size: 15px; font-weight: 600; line-height: 1.45; }
  .hero-role .muted { font-weight: 400; }
  .hero-headline {
    margin-top: 14px; font-family: var(--serif); font-weight: 360; font-size: 22px; line-height: 1.3;
    color: var(--soft); font-variation-settings: 'opsz' 36;
  }
  @media (min-width: 1024px) {
    /* On desktop the name, role and headline are in the left column. */
    .hero-mobile { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; margin: -1px; }
  }

  .hero-row { margin-top: 40px; display: grid; gap: 36px; }
  .portrait { margin: 0; }
  .portrait-img {
    aspect-ratio: 9 / 11; max-height: 440px;
    background: var(--card); border: 1px solid var(--rule);
    display: flex; align-items: center; justify-content: center; text-align: center; padding: 16px;
    font-size: 14px; color: var(--soft);
  }
  .portrait figcaption { margin-top: 12px; }
  .facts { margin: 0; display: flex; flex-direction: column; gap: 18px; order: 2; }
  .facts > div { padding-top: 12px; border-top: 1px solid var(--rule); }
  .facts dd {
    margin: 2px 0 0; font-family: var(--serif); font-weight: 380; font-size: clamp(19px, 1.6vw, 20px); line-height: 1.3;
    font-variation-settings: 'opsz' 36;
  }
  @media (min-width: 640px) { .portrait { margin-left: 48px; } }
  @media (min-width: 1200px) {
    .hero-row { margin-top: 56px; grid-template-columns: minmax(0, 1fr) minmax(0, 360px); gap: 40px; align-items: end; }
    .portrait { margin-left: 0; order: 2; }
    .facts { order: 1; margin-bottom: 38px; }
  }
  @media (min-width: 1024px) and (max-width: 1199px) {
    .portrait { max-width: 360px; margin-left: auto; }
  }

  .supporting { margin-top: 28px; max-width: 540px; }
  .keyfacts {
    margin-top: 64px; padding-top: 28px; border-top: 1px solid var(--rule);
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 2vw, 24px);
  }
  .keyfact-num {
    font-family: var(--serif); font-weight: 300; font-size: clamp(68px, 7.5vw, 104px); line-height: 0.9; letter-spacing: -0.03em;
    color: var(--accent-text); font-variation-settings: 'opsz' 144; font-variant-numeric: tabular-nums;
  }
  .keyfact-label { margin-top: 14px; font-size: clamp(14px, 1.2vw, 15px); line-height: 1.4; }

  .go-list { list-style: none; margin: -8px 0 0; padding: 0; }
  .go {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 24px;
    padding: 28px 0; border-bottom: 1px solid var(--rule); text-decoration: none;
  }
  .go-title {
    display: block; font-family: var(--serif); font-weight: 360; font-size: clamp(28px, 2.6vw, 34px); line-height: 1.1;
    transition: color .3s ease;
  }
  .go-text { display: block; margin-top: 6px; font-size: 15px; }
  .go-line { display: flex; align-items: center; color: var(--soft); }
  .go-ln { display: block; width: 40px; height: 1.5px; background: currentColor; transition: width .35s var(--ease); }
  .go-dot { display: block; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); transform: scale(0); transition: transform .35s var(--ease); }
  .go:hover .go-ln, .go:focus-visible .go-ln { width: 120px; }
  .go:hover .go-dot, .go:focus-visible .go-dot { transform: scale(1); }
  .go:hover .go-title, .go:focus-visible .go-title { color: var(--accent-text); }
  @media (max-width: 639px) { .go:hover .go-ln, .go:focus-visible .go-ln { width: 64px; } }
  @media (prefers-reduced-motion: reduce) { .go-ln, .go-dot, .go-title { transition: none; } }
</style>
