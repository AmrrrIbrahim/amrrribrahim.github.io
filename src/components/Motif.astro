---
// "One story": five deal documents that become one line (brief section 8).
// Drawn in its starting state; the scroll script merges the lines.
import { MOTIF, motifState } from '../lib/motif.js';

const variants = (['desktop', 'mobile'] as const).map((key) => {
  const g = MOTIF[key];
  return { key, g, s: motifState(g, 0) };
});
---
{variants.map(({ key, g, s }) => (
  <svg
    class={`motif motif--${key}`}
    viewBox={`0 0 ${g.w} ${g.h}`}
    data-motif={key}
    role="img"
    aria-label="Five parts of a deal, scope, effort, timeline, staffing and commercials, drawn as separate lines that merge into one straight line"
  >
    <g class="motif-lines" opacity={s.lineOpacity} data-lines>
      {s.docs.map((d) => <path d={d.d} data-doc />)}
    </g>
    <g class="motif-labels" opacity={s.labelOpacity} font-size={g.fontSize} data-labels>
      {s.docs.map((d) => <text x={d.x} y={d.ly} data-doc-label>{d.label}</text>)}
    </g>
    <line class="motif-accent" x1={s.accentStart} y1={g.y} x2={g.end} y2={g.y} data-accent />
    <circle class="motif-dot" cx={s.accentStart} cy={g.y} r={key === 'desktop' ? 3 : 2.5} data-accent-start />
    <circle class="motif-dot" cx={g.end} cy={g.y} r={key === 'desktop' ? 6 : 5} />
  </svg>
))}

<style>
  .motif { width: 100%; height: auto; overflow: visible; }
  .motif--desktop { display: none; }
  @media (min-width: 640px) {
    .motif--desktop { display: block; }
    .motif--mobile { display: none; }
  }
  .motif-lines { fill: none; stroke: var(--soft); stroke-width: 1.5; stroke-linecap: round; }
  .motif-labels { fill: var(--soft); font-family: var(--sans); }
  .motif-accent { stroke: var(--accent); stroke-width: 3; stroke-linecap: round; }
  .motif-dot { fill: var(--accent); }
</style>
