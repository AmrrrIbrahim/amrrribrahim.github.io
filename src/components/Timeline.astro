---
// Experience timeline (brief section 8).
// Wide screens: a horizontal row of stops. On desktop the section pins while
// the visitor scrolls and the row pans sideways; arrow buttons, trackpad,
// Tab and the arrow keys also move it. Clicking a stop opens its details in
// the panel below. Narrow screens: a vertical list that expands in place.
// Order: the current role comes first; scrolling goes back to earlier roles.
import SectionTitle from './SectionTitle.astro';
import type { Stop } from '../data/en/experience';

interface Props { stops: Stop[]; num: number; }
const { num } = Astro.props;
// The data lists roles oldest first; show them newest first.
const stops = [...Astro.props.stops].reverse();
const defaultId = stops[0].id;
const bands = [...new Set(stops.map((s) => s.band))];
const isFirstOfBand = (i: number) => i === 0 || stops[i - 1].band !== stops[i].band;
---
<section id="timeline" class="sec tl" data-timeline>
  <div class="tl-pin" data-tl-pin>
    <div class="tl-sticky">
      <div class="tl-head">
        <SectionTitle num={num}>Timeline</SectionTitle>
        <div class="tl-arrows">
          <button type="button" class="tl-arrow" aria-label="Show more recent roles" data-tl-prev>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
          </button>
          <button type="button" class="tl-arrow" aria-label="Show earlier roles" data-tl-next>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
          </button>
        </div>
      </div>

      <div class="tl-view" data-tl-view role="region" aria-label="Roles from newest to oldest" tabindex="0">
        <ol class="tl-track">
          {stops.map((s, i) => (
            <li class="tl-stop" data-band={s.band.toLowerCase()}>
              <span class="tl-band" aria-hidden="true">{isFirstOfBand(i) ? s.band : ''}</span>
              <button
                type="button"
                class="tl-card"
                data-stop={s.id}
                aria-pressed={s.id === defaultId ? 'true' : 'false'}
                aria-controls={`panel-${s.id}`}
              >
                <span class="sr-only">{s.band}: </span>
                <span class="tl-dates tnum">{s.dates}</span>
                <span class="tl-role">{s.role}</span>
                <span class="tl-org">{s.org}</span>
                <span class="tl-line">{s.line}</span>
              </button>
              <span class="tl-dot" aria-hidden="true"></span>
            </li>
          ))}
        </ol>
      </div>

      <div class="tl-details" aria-live="polite">
        {stops.map((s) => (
          <div class:list={['tl-panel', { 'is-active': s.id === defaultId }]} id={`panel-${s.id}`} data-panel={s.id}>
            <p class="tl-meta small"><span class:list={['tl-meta-band', `band-${s.band.toLowerCase()}`]}>{s.band}</span><span class="tnum muted">{s.dates}</span></p>
            <h3 class="tl-ptitle">{s.role}</h3>
            <p class="tl-team muted">{s.team}</p>
            <div class="tl-groups">
              {s.groups.map((g) => (
                <div class="tl-group">
                  {g.title && (
                    <div class="tl-ghead">
                      <h4>{g.title}</h4>
                      <p class="small muted tnum">{g.meta}</p>
                    </div>
                  )}
                  <ul>{g.bullets.map((b) => <li>{b}</li>)}</ul>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="tlv-head"><SectionTitle num={num}>Timeline</SectionTitle></div>
  <ol class="tlv">
    {bands.map((band) => (
      <li class="tlv-band" data-band={band.toLowerCase()}>
        <p class="tlv-name">{band}</p>
        <ol class="tlv-stops">
          {stops.filter((s) => s.band === band).map((s) => (
            <li class="tlv-stop reveal">
              <details open={s.id === defaultId}>
                <summary>
                  <span class="tl-dates tnum">{s.dates}</span>
                  <span class="tlv-role">{s.role}</span>
                  <span class="tl-org">{s.org}</span>
                  <span class="tlv-line">{s.line}</span>
                </summary>
                <div class="tlv-body">
                  <p class="small muted">{s.team}</p>
                  {s.groups.map((g) => (
                    <div class="tl-group">
                      {g.title && (
                        <div class="tl-ghead">
                          <h3>{g.title}</h3>
                          <p class="small muted tnum">{g.meta}</p>
                        </div>
                      )}
                      <ul>{g.bullets.map((b) => <li>{b}</li>)}</ul>
                    </div>
                  ))}
                </div>
              </details>
            </li>
          ))}
        </ol>
      </li>
    ))}
  </ol>
</section>

<style>
  /* One plain line for all roles. Bands are shown by their names only;
     orange is used for nothing but the selected role. */
  .tl, .tlv { --lw: 1.5px; --lc: var(--soft); --lo: .6; --dot-bg: var(--paper); --dot-bd: var(--ink); --band: var(--ink); }

  /* ----- Horizontal (768px and wider) ----- */
  .tl-pin { display: none; }
  @media (min-width: 768px) {
    .tl-pin { display: block; }
    .tlv, .tlv-head { display: none; }
  }

  .tl-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
  .tl-head :global(.sec-title) { margin: 0; }
  .tl-arrows { display: flex; gap: 8px; }
  .tl-arrow {
    width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;
    background: none; border: 1px solid var(--rule); border-radius: 50%; color: var(--ink); cursor: pointer;
    transition: border-color .2s ease;
  }
  .tl-arrow:hover:not(:disabled) { border-color: var(--ink); }
  .tl-arrow:disabled { opacity: .35; cursor: default; }

  .tl-view {
    overflow-x: auto; overflow-y: hidden;
    margin-right: calc(-1 * var(--gutter));
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .tl-view::-webkit-scrollbar { display: none; }
  @media (min-width: 1024px) { .tl-view { margin-right: calc(-1 * var(--pad-end)); } }

  .tl-track {
    list-style: none; margin: 0; padding: 0 40px 0 0;
    display: flex; gap: 24px; width: max-content;
  }
  .tl-stop { position: relative; flex: 0 0 220px; padding-bottom: 40px; }
  .tl-stop::after {
    content: ""; position: absolute; left: 0; right: -24px; bottom: calc(20px - var(--lw) / 2);
    height: var(--lw); background: var(--lc); opacity: var(--lo);
    transform-origin: left center;
  }
  .tl-stop:last-child::after { right: 0; }
  .tl-band { display: block; height: 32px; font-size: 14px; font-weight: 600; color: var(--band); }

  .tl-card {
    width: 220px; height: 200px; padding: 18px;
    display: flex; flex-direction: column; align-items: flex-start; text-align: left;
    background: var(--card); border: 1.5px solid var(--rule); border-radius: 4px;
    color: var(--ink); cursor: pointer;
    transition: transform .25s ease, border-color .25s ease, opacity .5s var(--ease);
  }
  .tl-card:hover { transform: translateY(-3px); border-color: var(--soft); }
  .tl-card[aria-pressed="true"] { border-color: var(--accent); }
  .tl-dates { font-size: 13px; color: var(--soft); }
  .tl-role { margin-top: 8px; font-family: var(--serif); font-weight: 400; font-size: 20px; line-height: 1.15; }
  .tl-org { margin-top: 4px; font-size: 14px; color: var(--soft); }
  .tl-line { margin-top: auto; font-size: 14px; line-height: 1.45; }

  .tl-dot {
    position: absolute; left: 4px; bottom: 14px; z-index: 1;
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--dot-bg); border: 2px solid var(--dot-bd);
    transition: transform .3s var(--ease), background-color .3s ease, border-color .3s ease, opacity .5s var(--ease);
  }
  .tl-stop:has(.tl-card[aria-pressed="true"]) .tl-dot { background: var(--accent); border-color: var(--accent); transform: scale(1.5); }

  .tl-details { margin-top: 20px; padding-top: 28px; border-top: 1px solid var(--rule); }
  :global(.js) .tl-panel:not(.is-active) { display: none; }
  .tl-panel + .tl-panel { margin-top: 48px; }
  :global(.js) .tl-panel + .tl-panel { margin-top: 0; }
  .tl-meta { display: flex; gap: 16px; }
  .tl-meta-band { font-weight: 600; }
  .tl-ptitle {
    margin: 10px 0 0; font-family: var(--serif); font-weight: 360; font-size: clamp(28px, 2.6vw, 34px); line-height: 1.12;
    letter-spacing: -0.01em; font-variation-settings: 'opsz' 72;
  }
  .tl-team { margin-top: 6px; font-size: 15px; }
  .tl-groups { margin-top: 22px; display: flex; flex-direction: column; gap: 28px; }
  .tl-group ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 10px; font-size: 16px; line-height: 1.55; }
  .tl-ghead { margin-bottom: 10px; padding-top: 14px; border-top: 1px solid var(--rule); }
  .tl-ghead h4, .tl-ghead h3 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: 22px; line-height: 1.2; }
  .tl-ghead p { margin-top: 4px; }

  /* Pinned on desktop: the section holds still while the row pans.
     The script sets the pinned height and top so the whole details panel
     stays readable (no scrolling inside it). */
  .tl.is-pinned .tl-pin { height: var(--pin-h, auto); }
  .tl.is-pinned .tl-sticky { position: sticky; top: var(--stick-top, 48px); }

  /* The line draws and the stops rise in as the row reaches them */
  .tl.is-animated .tl-stop::after { transform: scaleX(0); transition: transform .6s var(--ease); }
  .tl.is-animated .tl-stop:not(.is-reached) .tl-card,
  .tl.is-animated .tl-stop:not(.is-reached) .tl-dot,
  .tl.is-animated .tl-stop:not(.is-reached) .tl-band { opacity: 0; transform: translateY(16px); }
  .tl.is-animated .tl-stop.is-reached::after { transform: scaleX(1); }
  .tl-band { transition: opacity .5s var(--ease), transform .5s var(--ease); }

  /* ----- Vertical (narrow screens) ----- */
  .tlv { list-style: none; margin: 0; padding: 0; }
  .tlv-band { position: relative; padding: 0 0 28px 30px; }
  .tlv-band::before {
    content: ""; position: absolute; top: 0; bottom: 0; left: calc(6px - var(--lw) / 2);
    width: var(--lw); background: var(--lc); opacity: var(--lo);
  }
  .tlv-name { margin-bottom: 6px; font-size: 14px; font-weight: 600; color: var(--band); }
  .tlv-stops { list-style: none; margin: 0; padding: 0; }
  .tlv-stop { position: relative; }
  .tlv-stop summary {
    position: relative; list-style: none; cursor: pointer;
    display: flex; flex-direction: column; padding: 12px 0; min-height: 44px;
  }
  .tlv-stop summary::-webkit-details-marker { display: none; }
  .tlv-stop summary::before {
    content: ""; position: absolute; left: -30px; top: 20px;
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--dot-bg); border: 2px solid var(--dot-bd);
    box-sizing: border-box;
  }
  .tlv-stop details[open] summary::before { background: var(--accent); border-color: var(--accent); transform: scale(1.3); }
  .tlv-role { margin-top: 4px; font-family: var(--serif); font-weight: 400; font-size: 21px; line-height: 1.2; }
  details[open] .tlv-role { color: var(--accent-text); }
  .tlv-line { margin-top: 6px; font-size: 15px; line-height: 1.45; }
  .tlv-body { margin: 2px 0 12px; padding-top: 14px; border-top: 1px solid var(--rule); display: flex; flex-direction: column; gap: 16px; }
  .tlv-body .tl-group ul { font-size: 15px; gap: 8px; padding-left: 18px; }
  .tlv-body .tl-ghead { border-top: 0; padding-top: 0; margin-bottom: 8px; }
  .tlv-body .tl-ghead h3 { font-size: 18px; }

  @media (prefers-reduced-motion: reduce) {
    .tl-card, .tl-dot, .tl-band { transition: none; }
  }
</style>
